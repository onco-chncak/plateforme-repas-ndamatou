# Copiez ce fichier vers .env.local, puis remplissez les valeurs de votre projet Firebase.
# Les variables VITE_* sont lues par Vite dans le navigateur.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Laissez vide pour utiliser la base Firestore par défaut.
# Si votre base porte un nom spécifique, mettez ce nom ici.
VITE_FIRESTORE_DATABASE_ID=

# Spark : les transactions sont contrôlées par les règles Firestore.
VITE_SECURE_BALANCE_FUNCTIONS=false
